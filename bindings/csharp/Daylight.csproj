<Project Sdk="Microsoft.NET.Sdk">

  <!-- netstandard2.0 + classic DllImport: loads in Rhino 6 to 8 with Grasshopper (.NET Framework 4.8; Rhino 8 also on
       .NET 7/8), Unity and .NET 8/9. No package references. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Daylight</RootNamespace>
    <AssemblyName>Daylight</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="check/**" />
    <None Remove="check/**" />
  </ItemGroup>

</Project>
