{
  "name": "daylight-mesh",
  "version": "0.1.0",
  "private": true,
  "description": "three.js / glTF meshes -> daylight core .dmesh / OBJ, Node runners for daylight.exe / views.exe and in-process (daylight_c.dll), a client for daylight_server",
  "license": "Apache-2.0 AND LicenseRef-Commons-Clause-1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./native": { "types": "./lib/native.d.ts", "default": "./lib/native.js" }
  },
  "files": ["lib"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.2.1"
  },
  "peerDependencies": {
    "koffi": "^3.3.8",
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "koffi": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.186.0",
    "koffi": "^3.3.8",
    "three": "^0.186.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
