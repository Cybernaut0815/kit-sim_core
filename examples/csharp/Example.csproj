<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# example (docs/csharp.md), run from the repo by "dotnet run" with this folder as its project. Program.cs
       points DAYLIGHT_DLL at the CMake build's daylight_c.dll when it is unset, so none is copied here; x64, as
       daylight_c.dll. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../bindings/csharp/Daylight.csproj" />
  </ItemGroup>

</Project>
